# AI26 browser collection: SAFE PLACEHOLDERS ONLY.
# Copy variable names into a private .env or shell environment outside Git.
# Fill real values from TomiToivio/LaclauGPT-Private/collection/ai26.

AI26_CONFIG=/path/to/private/ai26.yaml
AI26_MONGO_DATABASE=laclaugpt

LACLAUGPT_PROJECT_ID=ai26
LACLAUGPT_RUN_ID=
LACLAUGPT_PROFILE=distributed
LACLAUGPT_MACHINE=laptop
LACLAUGPT_EXECUTION=cli
LACLAUGPT_BROWSER=firefox-local
LACLAUGPT_CALLER=human-cli

LACLAUGPT_PRIVATE_CONFIG_DIR=/path/to/LaclauGPT-Private/collection/ai26
LACLAUGPT_DATA_ROOT=/path/to/private/ai26-data
LACLAUGPT_SQLITE_PATH=/path/to/private/ai26-data/database/collection.sqlite3

# Local browser backend. Keep loopback-only.
LACLAUGPT_BROWSER_HOST=127.0.0.1
LACLAUGPT_BROWSER_PORT=8766

# Canonical structured records -> remote MongoDB.
LACLAUGPT_RECORD_BACKEND=mongodb
LACLAUGPT_MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/
LACLAUGPT_MONGODB_DATABASE=laclaugpt
LACLAUGPT_MONGODB_COLLECTION=

# Coordination/control plane -> remote Redis.
LACLAUGPT_CACHE_BACKEND=redis
LACLAUGPT_DISTRIBUTED_CONFIG_BACKEND=redis
LACLAUGPT_REDIS_URL=redis://USER:PASSWORD@HOST:PORT/DB
LACLAUGPT_REDIS_KEY_PREFIX=laclaugpt

# Raw capture objects + media -> CSC Allas / S3-compatible storage.
LACLAUGPT_OBJECT_BACKEND=s3
LACLAUGPT_S3_ENDPOINT=https://OBJECT-STORAGE-ENDPOINT
LACLAUGPT_S3_REGION=
LACLAUGPT_S3_BUCKET=PRIVATE-BUCKET
LACLAUGPT_S3_PREFIX_ROOT=projects
LACLAUGPT_S3_ACCESS_KEY=ACCESS_KEY
LACLAUGPT_S3_SECRET_KEY=SECRET_KEY
LACLAUGPT_S3_SIGNATURE_VERSION=s3
LACLAUGPT_S3_ADDRESSING_STYLE=auto

# Never add real credentials, private hosts, VPN/LAN addresses, machine paths,
# operational study targets or collected data to this public repository.
