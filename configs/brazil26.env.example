# Brazil26 localhost researcher collection: SAFE PLACEHOLDERS ONLY.
# Copy to ignored data/config/brazil26-localhost.env.
# Live targets/codebooks and credentials belong in private configuration storage or other
# ignored local configuration.

LACLAUGPT_PROJECT_ID=brazil26
LACLAUGPT_RUN_ID=
LACLAUGPT_PROFILE=brazil26-localhost
LACLAUGPT_MACHINE=laptop
LACLAUGPT_EXECUTION=cli
LACLAUGPT_BROWSER=firefox-local
LACLAUGPT_CALLER=human-cli

# Private operational study YAML. Prefer BRAZIL26_CONFIG for the exact file.
LACLAUGPT_PRIVATE_CONFIG_DIR=/path/to/private-config/brazil26
BRAZIL26_CONFIG=/path/to/private-config/brazil26/study.yaml

# Local researcher state. These defaults do not require network infrastructure.
LACLAUGPT_DATA_ROOT=./data
LACLAUGPT_SQLITE_PATH=./data/database/collection.sqlite3
LACLAUGPT_CSV_PATH=./data/csv/records.csv
LACLAUGPT_RECORD_BACKEND=auto
LACLAUGPT_OBJECT_BACKEND=filesystem
LACLAUGPT_CACHE_BACKEND=memory
LACLAUGPT_DISTRIBUTED_CONFIG_BACKEND=local
LACLAUGPT_MESSAGING_BACKEND=none
LACLAUGPT_TASK_QUEUE_BACKEND=direct

# Local browser backend. Keep loopback-only.
LACLAUGPT_BROWSER_HOST=127.0.0.1
LACLAUGPT_BROWSER_PORT=8765
# Capture only public TikTok video bytes already authorized in this Firefox session.
LACLAUGPT_CAPTURE_MEDIA_INLINE=true
LACLAUGPT_CAPTURE_MEDIA_MAX_BYTES=67108864

# Use a dedicated Firefox profile for Brazil26.
LACLAUGPT_FIREFOX_PROFILE="Brazil26 Research"
# Alternatively:
# LACLAUGPT_FIREFOX_PROFILE_PATH=/private/path/to/firefox/profile
# LACLAUGPT_FIREFOX_COMMAND=firefox

# Public-safe source manifest. An approved private manifest can override this.
LACLAUGPT_SOURCE_MANIFEST=./data/config/brazil26.sources.toml

# Conservative bounded RSS collection defaults for a researcher laptop.
LACLAUGPT_RSS_MAX_FEEDS=3
LACLAUGPT_RSS_PER_FEED_LIMIT=6
LACLAUGPT_RSS_BATCH_LIMIT=30

# --- Optional distributed mode ---
# Uncomment/configure these only when MongoDB / Redis / CSC Allas are intended.
# Any one of these distributed backends makes the browser runtime enable remote
# mirroring. Keep secrets out of Git.
#
# LACLAUGPT_PROFILE=brazil26-localhost-remote
# LACLAUGPT_RECORD_BACKEND=mongodb
# LACLAUGPT_MONGODB_URI=mongodb://HOST:PORT/
# LACLAUGPT_MONGODB_DATABASE=laclaugpt
# LACLAUGPT_MONGODB_COLLECTION=
#
# LACLAUGPT_DISTRIBUTED_CONFIG_BACKEND=redis
# LACLAUGPT_REDIS_URL=redis://HOST:PORT/DB
# LACLAUGPT_REDIS_KEY_PREFIX=laclaugpt
#
# LACLAUGPT_OBJECT_BACKEND=s3
# For CSC Allas, authenticate with allas-conf in S3 mode; boto3 reads ~/.aws/.
# Do not paste Allas access/secret keys into this env file.
# LACLAUGPT_S3_ENDPOINT=https://OBJECT-STORAGE-ENDPOINT
# LACLAUGPT_S3_REGION=
# LACLAUGPT_S3_BUCKET=PRIVATE-BUCKET
# LACLAUGPT_S3_PREFIX_ROOT=projects
# LACLAUGPT_S3_SIGNATURE_VERSION=s3
# LACLAUGPT_S3_ADDRESSING_STYLE=auto
