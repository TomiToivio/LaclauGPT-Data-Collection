# This file contains placeholders only. Copy it to .env for local use.
LACLAUGPT_PROJECT_ID=default
LACLAUGPT_RUN_ID=
LACLAUGPT_PROFILE=laptop-firefox-local
LACLAUGPT_MACHINE=laptop
LACLAUGPT_EXECUTION=cli
LACLAUGPT_BROWSER=firefox-local
LACLAUGPT_CALLER=human-cli
LACLAUGPT_PRIVATE_CONFIG_DIR=
LACLAUGPT_DATA_ROOT=./data
LACLAUGPT_SQLITE_PATH=./data/database/collection.sqlite3
LACLAUGPT_BROWSER_HOST=127.0.0.1
LACLAUGPT_BROWSER_PORT=8765

# Select independently when distributed operation is desired.
# LACLAUGPT_RECORD_BACKEND=mongodb
# LACLAUGPT_OBJECT_BACKEND=s3
# LACLAUGPT_CACHE_BACKEND=redis

# Direct/no-Redis is the default messaging/task mode.
LACLAUGPT_MESSAGING_BACKEND=none
LACLAUGPT_TASK_QUEUE_BACKEND=direct

# Distributed record backend (optional)
LACLAUGPT_MONGODB_URI=mongodb://localhost:27017
LACLAUGPT_MONGODB_DATABASE=laclaugpt

# Distributed coordination/cache/task queues/messaging (optional).
# Keep the actual connection URL only in your private runtime .env/environment.
# To enable queue/event publishing set the backends above to redis and define:
# LACLAUGPT_REDIS_URL=<private-runtime-value>

# S3-compatible object storage (optional; CSC Allas supported).
# Preferred variable names follow the umbrella distributed-run contract.
LACLAUGPT_S3_ENDPOINT=https://object-storage.example.invalid
LACLAUGPT_S3_REGION=region-name
LACLAUGPT_S3_BUCKET=bucket-name
LACLAUGPT_S3_ACCESS_KEY=replace-locally
LACLAUGPT_S3_SECRET_KEY=replace-locally
# Backwards-compatible aliases also remain supported:
# LACLAUGPT_S3_ENDPOINT_URL=
# LACLAUGPT_S3_ACCESS_KEY_ID=
# LACLAUGPT_S3_SECRET_ACCESS_KEY=

# Optional graph/vector RAG indexing. Disabled by default.
LACLAUGPT_RAG_ENABLED=false
LACLAUGPT_RAG_BACKEND=none
LACLAUGPT_RAG_DATASET=
LACLAUGPT_RAG_FAILURE_LOG=./data/logs/rag-index-failures.jsonl
# Configure local or remote Neo4j only in your private .env.
LACLAUGPT_NEO4J_URI=
LACLAUGPT_NEO4J_DATABASE=neo4j
LACLAUGPT_NEO4J_USER=
LACLAUGPT_NEO4J_PASSWORD=
# Embedding/Ollama remains optional; do not hard-code a chat model here.
LACLAUGPT_EMBEDDING_PROVIDER=none
LACLAUGPT_EMBEDDING_ENDPOINT=
LACLAUGPT_EMBEDDING_MODEL=

# Source-specific values are runtime-only and should be supplied locally.
BSKY_ACCESS_TOKEN=replace-locally
YOUTUBE_API_KEY=replace-locally
TELEGRAM_API_ID=replace-locally
TELEGRAM_API_HASH=replace-locally
